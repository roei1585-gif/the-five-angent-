# =====================================================================
# .env.example - תבנית למשתני סביבה של הפרויקט
# =====================================================================
# כדי להשתמש:
#   1. העתק את הקובץ הזה ל-.env  (cp .env.example .env)
#   2. מלא ערכים אמיתיים ב-.env
#
# חשוב: .env נמצא ב-.gitignore ולא עולה לגיט. .env.example כן עולה,
# אז אסור לשים פה ערכים אמיתיים - רק שמות מפתחות וערכי דוגמה.
# =====================================================================


# --- מפתחות API לסוכנים ---
# כל סוכן בצוות עשוי להזדקק לשירותים חיצוניים. נמלא לפי הצורך
# כשנגדיר את הסוכנים עצמם.

# ANTHROPIC_API_KEY=sk-ant-...        # לקריאות ישירות ל-Claude API (אם נצטרך)

# --- יובל (מעצב התמונות) ---
OPENAI_API_KEY=sk-...                  # OpenAI Images API (gpt-image-2) — נדרש ליובל
# REPLICATE_API_TOKEN=r8_...           # מודלי תמונה ב-Replicate
# STABILITY_API_KEY=sk-...             # Stable Diffusion

# --- חן (חוקרת) ---
# TAVILY_API_KEY=tvly-...              # חיפוש ומחקר
# BRAVE_SEARCH_API_KEY=BSA...          # Brave Search API
# PERPLEXITY_API_KEY=pplx-...          # Perplexity

# --- יעל (כותבת תוכן) ---
# כרגע לא ידועים משתנים נדרשים - תיווסף כאן עם הגדרת הסוכן

# --- כללי ---
# LOG_LEVEL=info                       # debug | info | warn | error
